<div class="theme-root screen-shell">
    <div class="screen-panel text-center max-w-2xl stagger-in">
        <p class="kicker stagger-in delay-1">Signal Control Room</p>
        <h1 class="title-main stagger-in delay-1">SOC OPS</h1>
        <p class="subtitle-main stagger-in delay-2">Social Bingo</p>

        <div class="rules-panel text-left stagger-in delay-2">
            <h2 class="font-semibold text-gray-900 mb-3">Mission Brief</h2>
            <ul class="rules-list text-sm">
                <li>Scan the room and identify people matching each prompt.</li>
                <li>Mark a tile when you confirm a match.</li>
                <li>Lock five tiles in a line to trigger BINGO.</li>
            </ul>
        </div>

        <button
            @onclick="OnStart"
            class="control-button text-lg stagger-in delay-3">
            Launch Session
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
