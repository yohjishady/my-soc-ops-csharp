<div class="modal-scrim">
    <div class="modal-card">
        <div class="kicker">Signal Achieved</div>
        <h2 class="modal-title">BINGO</h2>
        <p class="text-gray-700 mb-6">You captured a full line. Continue scanning for more matches.</p>

        <button
            @onclick="OnDismiss"
            class="control-button">
            Keep Tracking
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
