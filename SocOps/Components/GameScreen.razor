@using SocOps.Models

<div class="theme-root game-layout">
    <header class="game-header stagger-in">
        <button
            @onclick="OnReset"
            class="ghost-button text-sm">
            ← Back
        </button>
        <h1 class="game-title">Soc Ops Console</h1>
        <div class="w-16"></div>
    </header>

    <p class="status-line stagger-in delay-1">
        Mark each contact as you verify their match.
    </p>

    @if (HasBingo)
    {
        <div class="status-badge stagger-in delay-2">
            Line secured. BINGO signal confirmed.
        </div>
    }

    <div class="flex-1 flex items-center justify-center p-3 stagger-in delay-2">
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
